+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.system;
+
+import android.app.settings.SettingsEnums;
+import android.graphics.drawable.Drawable;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+
+import com.android.settings.R;
+import com.android.settings.widget.RadioButtonPickerFragment;
+import com.android.settingslib.widget.CandidateInfo;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Single choice page letting the user pick the system wide log level, which is stored by
+ * {@link LogLevelUtils} and published to {@link LogLevelUtils#PROPERTY_LOG_LEVEL}.
+ */
+public class LogLevelSettings extends RadioButtonPickerFragment {
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.SETTINGS_SYSTEM_CATEGORY;
+    }
+
+    @Override
+    protected int getPreferenceScreenResId() {
+        return R.xml.log_level_settings;
+    }
+
+    @Override
+    protected List<? extends CandidateInfo> getCandidates() {
+        final List<CandidateInfo> candidates = new ArrayList<>();
+        for (int level = LogLevelUtils.LEVEL_VERBOSE;
+                level <= LogLevelUtils.LEVEL_SILENT;
+                level++) {
+            candidates.add(new LogLevelCandidateInfo(
+                    LogLevelUtils.getLabel(getPrefContext(), level),
+                    String.valueOf(level)));
+        }
+        return candidates;
+    }
+
+    @Override
+    protected String getDefaultKey() {
+        return String.valueOf(LogLevelUtils.getLevel(getPrefContext()));
+    }
+
+    @Override
+    protected boolean setDefaultKey(String key) {
+        try {
+            return LogLevelUtils.setLevel(getPrefContext(), Integer.parseInt(key));
+        } catch (NumberFormatException e) {
+            return false;
+        }
+    }
+
+    @Override
+    protected void onSelectionPerformed(boolean success) {
+        super.onSelectionPerformed(success);
+
+        if (success && getActivity() != null) {
+            getActivity().finish();
+        }
+    }
+
+    private static final class LogLevelCandidateInfo extends CandidateInfo {
+        private final CharSequence mLabel;
+        private final String mKey;
+
+        LogLevelCandidateInfo(@NonNull CharSequence label, @NonNull String key) {
+            super(/* enabled */ true);
+            mLabel = label;
+            mKey = key;
+        }
+
+        @Override
+        public CharSequence loadLabel() {
+            return mLabel;
+        }
+
+        @Nullable
+        @Override
+        public Drawable loadIcon() {
+            return null;
+        }
+
+        @Override
+        public String getKey() {
+            return mKey;
+        }
+    }
+}
diff --git a/src/com/android/settings/system/LogLevelUtils.java b/src/com/android/settings/system/LogLevelUtils.java
new file mode 100644
index 00000000000..2dab9b74d1b
--- /dev/null
+++ b/src/com/android/settings/system/LogLevelUtils.java
@@ -0,0 +1,146 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.system;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemProperties;
+import android.os.UserHandle;
+import android.util.Log;
+
+import androidx.annotation.StringRes;
+
+import com.android.settings.R;
+
+/**
+ * Stores the log level the user picked and keeps {@link #PROPERTY_LOG_LEVEL} in sync with it.
+ *
+ * <p>The choice itself lives in {@link #PREFS_NAME} so that it survives a reboot, whereas
+ * {@link #PROPERTY_LOG_LEVEL} is deliberately non-persistent. That property therefore stays unset
+ * from power-on until {@link LogLevelBootReceiver} applies the stored choice after boot, which is
+ * what allows every log message through while the device is booting.
+ *
+ * <p>The value written to the property is the numeric {@link android.util.Log} priority of the
+ * lowest level that should be emitted, plus an extra {@link #LEVEL_SILENT} value on top of
+ * {@link #LEVEL_FATAL} that asks for no logging at all.
+ */
+public final class LogLevelUtils {
+
+    private static final String TAG = "LogLevelUtils";
+
+    /** SharedPreferences file holding the level the user picked. */
+    private static final String PREFS_NAME = "log_level";
+
+    /** Key of the level inside {@link #PREFS_NAME}. */
+    private static final String PREF_LEVEL = "level";
+
+    /**
+     * Non-persistent system property read by liblog to decide whether a message is written out.
+     * Nothing writes it during the boot sequence, so logging stays unrestricted until
+     * {@link LogLevelBootReceiver} runs.
+     */
+    public static final String PROPERTY_LOG_LEVEL = "sys.strix.log_level";
+
+    public static final int LEVEL_VERBOSE = 2;
+    public static final int LEVEL_DEBUG = 3;
+    public static final int LEVEL_INFO = 4;
+    public static final int LEVEL_WARN = 5;
+    public static final int LEVEL_ERROR = 6;
+    public static final int LEVEL_FATAL = 7;
+    public static final int LEVEL_SILENT = 8;
+
+    /** Level reported when the user has never made a choice. */
+    public static final int DEFAULT_LEVEL = LEVEL_VERBOSE;
+
+    private LogLevelUtils() {
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE);
+    }
+
+    /** Returns the level the user picked, falling back to {@link #DEFAULT_LEVEL}. */
+    public static int getLevel(Context context) {
+        final int level = prefs(context).getInt(PREF_LEVEL, DEFAULT_LEVEL);
+        if (level >= LEVEL_VERBOSE && level <= LEVEL_SILENT) {
+            return level;
+        }
+        Log.w(TAG, "Ignoring an out of range stored log level: " + level);
+        return DEFAULT_LEVEL;
+    }
+
+    /**
+     * Stores {@code level} and applies it straight away, so the new filter takes effect without
+     * waiting for the next reboot.
+     *
+     * <p>Only the primary user may do this: the stored level is per user while
+     * {@link #PROPERTY_LOG_LEVEL} applies to the whole device.
+     */
+    public static boolean setLevel(Context context, int level) {
+        if (UserHandle.myUserId() != UserHandle.USER_SYSTEM) {
+            Log.w(TAG, "Refusing to change the log level from user " + UserHandle.myUserId());
+            return false;
+        }
+        if (level < LEVEL_VERBOSE || level > LEVEL_SILENT) {
+            Log.w(TAG, "Refusing to store an out of range log level: " + level);
+            return false;
+        }
+        prefs(context).edit().putInt(PREF_LEVEL, level).apply();
+        applyLevel(level);
+        return true;
+    }
+
+    /**
+     * Publishes the stored level into {@link #PROPERTY_LOG_LEVEL}. Called once boot has finished:
+     * the property is non-persistent and so is empty for the whole boot sequence, and this is what
+     * turns the filter on again after a reboot.
+     */
+    public static void applyStoredLevel(Context context) {
+        applyLevel(getLevel(context));
+    }
+
+    private static void applyLevel(int level) {
+        SystemProperties.set(PROPERTY_LOG_LEVEL, String.valueOf(level));
+    }
+
+    /** Returns the title resource describing {@code level}. */
+    @StringRes
+    public static int getLabelRes(int level) {
+        switch (level) {
+            case LEVEL_VERBOSE:
+                return R.string.log_level_verbose;
+            case LEVEL_DEBUG:
+                return R.string.log_level_debug;
+            case LEVEL_INFO:
+                return R.string.log_level_info;
+            case LEVEL_ERROR:
+                return R.string.log_level_error;
+            case LEVEL_FATAL:
+                return R.string.log_level_fatal;
+            case LEVEL_SILENT:
+                return R.string.log_level_silent;
+            case LEVEL_WARN:
+            default:
+                return R.string.log_level_warn;
+        }
+    }
+
+    /** Returns the translated title describing {@code level}. */
+    public static CharSequence getLabel(Context context, int level) {
+        return context.getText(getLabelRes(level));
+    }
+}
