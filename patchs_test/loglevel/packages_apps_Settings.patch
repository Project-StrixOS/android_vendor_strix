+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+package com.android.settings.system;
+
+import android.content.Context;
+import android.os.UserHandle;
+
+import androidx.annotation.NonNull;
+
+import com.android.settings.core.BasePreferenceController;
+
+/**
+ * Shows the log level the user picked, as stored by {@link LogLevelUtils}.
+ */
+public class LogLevelPreferenceController extends BasePreferenceController {
+
+    public LogLevelPreferenceController(@NonNull Context context, @NonNull String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        // sys.strix.log_level is device global while the stored level is per user, so only the
+        // primary user is allowed to change it. DISABLED_FOR_USER is not part of
+        // isAvailable(), which keeps the entry hidden for everybody else.
+        return UserHandle.myUserId() == UserHandle.USER_SYSTEM
+                ? AVAILABLE
+                : DISABLED_FOR_USER;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        return LogLevelUtils.getLabel(mContext, LogLevelUtils.getLevel(mContext));
+    }
+}
